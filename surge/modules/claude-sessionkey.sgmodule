#!name=Claude sessionKey Capture
#!desc=抓取 claude.ai 的 sessionKey/Cookie/UA/org，点击通知即复制可导入 claude-free-proxy 的 JSON（仅限自己的账号，数据只存本机 Surge）
#!author=cjf0423

[Script]
Claude Key Capture = type=http-request,pattern=^https?:\/\/claude\.ai\/,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/surge/scripts/claude-sessionkey.js

[MITM]
hostname = %APPEND% claude.ai

#!name=Block Advertising
#!desc=Block Advertising (Refactored for Surge 5: URL-REGEX + Auto MITM)

[General]
force-http-engine-hosts = %APPEND% intl.iqiyi.com, maicai.api.ddxq.mobi, mobileapi-v6.elong.com, wmapi.meituan.com, weibointl.api.weibo.cn, *.ott.cibntv.net

[Rule]
URL-REGEX,^https?:\/\/api\.m\.jd.com\/client\.action\?functionId=start,REJECT

[MITM]
hostname = %APPEND% api.21jingji.com,api.m.jd.com,app.58.com,c.tieba.baidu.com,cube.elemecdn.com,flowplus.meituan.net

#!name=ipaTool 应用下载
#!desc=App Store 历史版本下载 & 已购下架应用安装
#!category=Tools
#!author=小H (基于 githubdulong)
#!version=3.0

[Script]
# 原始 API 服务（和原始模块完全一致）
应用接口 = type=http-request,pattern=https://apple-api.com,requires-body=1,max-size=-1,binary-body-mode=0,timeout=30,debug=1,script-path=https://raw.githubusercontent.com/githubdulong/Script/master/AppleStoreAPI.js,timeout=120
# IPA 安装清单生成
应用安装 = type=http-request,pattern=https:\/\/xiaobai\.app,requires-body=0,script-path=https://raw.githubusercontent.com/githubdulong/Script/master/installapp.js,timeout=120

[MITM]
hostname = %APPEND% apple-api.com, xiaobai.app

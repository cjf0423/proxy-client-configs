#!name=Tuyo KYC Bypass
#!desc=绕过 Tuyo 新版 KYC 验证，恢复银行转账及 IBAN 显示
#!category=Tuyo
#!author=cjf0423
#!homepage=https://github.com/cjf0423/proxy-client-configs
#!version=1.0.0

[Script]
tuyo-kyc-req = type=http-request, pattern=^https://api\.tuyo\.com/account/(verification|connect), requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/surge/scripts/tuyo-kyc-bypass.js, timeout=30

tuyo-kyc-res = type=http-response, pattern=^https://api\.tuyo\.com/account/(verification|connect), requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/surge/scripts/tuyo-kyc-bypass.js, timeout=30

[MITM]
hostname = %APPEND% api.tuyo.com

#!name=Pixiv · 全局增强翻译
#!desc=适配 8.9.2 等版本：全页面日文深度汉化 · AI 视觉多模态漫翻 · 内置设置中心。\n• 出版级双语小说阅读：原文在上一一对应，渐进式渲染与失败重试\n• 统一 Apple SF Symbols 单色矢量图标系统与 Grouped 规范设计\n• 悬浮按钮纯粹总开关控制，自动避开原生控件且滚动不跳跃\n• 真实可管理本地缓存统计（字节级大小、条目数、最近时间、清理反馈）\n• 首页/榜单/详情/评论/画师主页全量汉化，彻底消除查看更多弹窗\n• 内置 2500+ 高频 Pixiv Tag 离线字典，0ms 极速秒翻且副标题自动净空。
#!category=Pixiv
#!author=TomCatXue (Surge adapted by cjf0423)
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/ca/d5/93/cad5932d-6ba6-7e5a-c2a9-818682fde6f3/AppIcon-0-0-1x_U007epad-0-1-85-220.png/512x512bb.jpg
#!version=4.4.6

[URL Rewrite]
# 劫持 Pixiv App 内「帮助中心」与「服务条款」，一键直达增强设置中心
^https?:\/\/app\.pixiv\.help(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302
^https?:\/\/policies\.pixiv\.net(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302

[Script]
# 设置中心 & API 交互 & 漫画查看器 (http-request: 配置读取/保存/实时测速/清空缓存/设置页面HTML/漫画查看器)
Pixiv.Enhanced.SettingsAPI = type=http-request, pattern=^https:\/\/(app-api|www)\.pixiv\.net\/(settings\/Enhanced|manga\/viewer|api\/), requires-body=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/surge/scripts/pixiv/pixiv_enhanced.js, script-update-interval=86400

# 全页面 REST API 响应体汉化拦截器（覆盖首页/推荐/榜单/详情/评论/画师主页/特辑/漫画/小说）
Pixiv.Enhanced.ApiTranslate = type=http-response, pattern=^https:\/\/app-api\.pixiv\.net\/v[1-3]\/(illust|manga|novel|user|search|trending-tags|spotlight|home), requires-body=1, max-size=0, timeout=60, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/surge/scripts/pixiv/pixiv_enhanced.js, script-update-interval=86400

# 小说阅读器 & 页面注入 iOS SF Symbols「文/A」悬浮按钮与排版引擎
Pixiv.Enhanced.WebviewInject = type=http-response, pattern=^https:\/\/app-api\.pixiv\.net\/webview\/v2\/novel, requires-body=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/surge/scripts/pixiv/pixiv_enhanced.js, script-update-interval=86400

# 翻译中转网关与 AI 视觉漫翻端点
Pixiv.Enhanced.Proxy = type=http-request, pattern=^https:\/\/(app-api|www)\.pixiv\.net\/pxtrans, requires-body=1, max-size=0, timeout=60, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/surge/scripts/pixiv/pixiv_enhanced.js, script-update-interval=86400

[MITM]
hostname = %APPEND% app-api.pixiv.net, app.pixiv.help, policies.pixiv.net, www.pixiv.net

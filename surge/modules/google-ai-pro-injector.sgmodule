#!name=Google AI Pro · 优惠注入
#!desc=✨ 数字切层 · 默认关闭 · 注入通知防刷屏。仅改写请求，最终金额与期限请以 Google 结账页为准。
#!category=Google
#!author=小龙虾 🦞 / 小H
#!version=2.1.0
#!arguments=layer:0
#!arguments-desc=🎛 注入档位（填写一个数字）\n0 · 关闭注入【默认】\n1 · 第一层｜12 个月\n2 · 第二层｜6 个月 SS\n3 · 第三层｜6 个月\n4 · 备用层｜6 个月\n\n🔔 实际改写后通知；同档位 2 分钟内去重，切换档位可再次通知。\n保存参数后请重新打开结账页。月份为原 token 标签，并非已验证优惠承诺。旧模块保存的 layer 不会自动重置，请检查为 0。

[MITM]
hostname = %APPEND% one.google.com, play.google.com, tokenized.play.google.com

[Script]
# Preserve v2.0.3's confirmed short-inner skip / outer-continue behavior.
# Disable older matching modules. layer=0 leaves requests untouched.
google-ai-pro-body = type=http-request, pattern=^https://one\.google\.com/_/SubscriptionsUi/data/batchexecute(?:[?#]|$), requires-body=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/32acf51a3e95e2afe75515312a5a355dfb41f28c/surge/scripts/google-ai-pro-inject.js?v=2.1.0, script-update-interval=86400, argument="{\"layer\":\"{{{layer}}}\"}"
google-ai-pro-ear = type=http-request, pattern=^https://(?:play|tokenized\.play)\.google\.com/(?:[^?#]*/)?eacquire/multiline(?:[?#]|$), requires-body=false, timeout=5, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/32acf51a3e95e2afe75515312a5a355dfb41f28c/surge/scripts/google-ai-pro-inject.js?v=2.1.0, script-update-interval=86400, argument="{\"layer\":\"{{{layer}}}\"}"

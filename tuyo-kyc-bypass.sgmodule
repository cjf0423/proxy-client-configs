#!name=Tuyo KYC Bypass
#!desc=绕过 Tuyo 新版 KYC 验证，恢复转账/IBAN 功能
#!category=Tuyo
#!author=小H

[Script]
# 请求阶段：移除缓存头
tuyo-req = type=http-request, pattern=^https://api\.tuyo\.com/(account/(verification|connect)|banking/overview), requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

# 响应阶段
tuyo-res-verification = type=http-response, pattern=^https://api\.tuyo\.com/account/verification, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

tuyo-res-connect = type=http-response, pattern=^https://api\.tuyo\.com/account/connect, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

tuyo-res-banking = type=http-response, pattern=^https://api\.tuyo\.com/banking/overview, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

[MITM]
hostname = %APPEND% api.tuyo.com

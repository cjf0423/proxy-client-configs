#!name=Tuyo KYC Bypass
#!desc=绕过 Tuyo 新版 KYC 验证，恢复转账/IBAN 功能（伪装旧版+修改验证状态）
#!category=Tuyo
#!author=小H

[Script]
# 请求阶段：移除缓存头 + 伪装旧版 App 版本号
tuyo-req = type=http-request, pattern=^https://api\.tuyo\.com/, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

# 响应阶段：修改 KYC 状态字段
tuyo-res = type=http-response, pattern=^https://api\.tuyo\.com/, requires-body=1, max-size=262144, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

[MITM]
hostname = %APPEND% api.tuyo.com

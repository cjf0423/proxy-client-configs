#!name=Tuyo KYC Bypass
#!desc=v7 minimal - 仅注入 verificationGraceActive 绕过 KYC
#!category=Tuyo
#!author=小H
#!version=7

[Script]
tuyo-req = type=http-request, pattern=^https://api\.tuyo\.com/account/verification, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

tuyo-res = type=http-response, pattern=^https://api\.tuyo\.com/account/verification, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/main/tuyo-kyc-bypass.js, timeout=30

[MITM]
hostname = %APPEND% api.tuyo.com

#!name=Tuyo KYC Bypass
#!desc=绕过 Tuyo 新版 KYC 验证，恢复转账/IBAN 功能
#!category=Tuyo
#!author=小H

[Script]
# 请求阶段：移除缓存头，强制返回完整响应
tuyo-req-connect = type=http-request, pattern=^https://api\.tuyo\.com/account/connect, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-req-verification = type=http-request, pattern=^https://api\.tuyo\.com/account/verification, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-req-fiat = type=http-request, pattern=^https://api\.tuyo\.com/fiat/, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-req-send = type=http-request, pattern=^https://api\.tuyo\.com/send/, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-req-deposit = type=http-request, pattern=^https://api\.tuyo\.com/deposit/, requires-body=0, max-size=0, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

# 响应阶段：修改 KYC 状态
tuyo-res-connect = type=http-response, pattern=^https://api\.tuyo\.com/account/connect, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-res-verification = type=http-response, pattern=^https://api\.tuyo\.com/account/verification, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-res-fiat = type=http-response, pattern=^https://api\.tuyo\.com/fiat/, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-res-send = type=http-response, pattern=^https://api\.tuyo\.com/send/, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

tuyo-res-deposit = type=http-response, pattern=^https://api\.tuyo\.com/deposit/, requires-body=1, max-size=131072, script-path=https://raw.githubusercontent.com/cjf0423/proxy-client-configs/master/tuyo-kyc-bypass.js, timeout=30

[MITM]
hostname = %APPEND% api.tuyo.com
